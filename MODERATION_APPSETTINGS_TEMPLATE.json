{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "CueFinder": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=cuefinder-postgres;Port=5432;Database=cuefinder;Username=postgres;Password=admin;SslMode=Disable;"
  },
  "JwtSettings": {
    "SecretKey": "your-super-secret-jwt-key-change-this-in-production-must-be-at-least-32-characters",
    "Issuer": "CueFinder",
    "Audience": "CueFinderUsers",
    "ExpirationMinutes": 60
  },
  "CorsOrigins": [
    "http://localhost:3000",
    "http://localhost:5000"
  ],
  "Caching": {
    "RedisConnectionString": "",
    "UseInMemory": true
  },
  "ImageSettings": {
    "MaxUploadSize": 10485760,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".gif", ".webp"],
    "UploadPath": "/app/uploads"
  },
  "Moderation": {
    "NudeNetUrl": "http://nudenet:8000",
    "MaxImageSize": 5242880,
    "AllowedMimes": ["image/jpeg", "image/png", "image/webp", "image/gif"],
    "ConfidenceThreshold": 0.6,
    "TempStoragePath": "uploads/temp",
    "ApprovedStoragePath": "uploads/approved",
    "FlaggedStoragePath": "uploads/moderation",
    "EnableModerationLogging": true
  },
  "Sms": {
    "Provider": "Mock",
    "ApiUrl": "",
    "ApiKey": "",
    "SenderId": "CueFinder"
  },
  "Features": {
    "EnableModeration": true,
    "EnableForums": true,
    "EnableMessaging": true,
    "EnableImageUpload": true
  }
}
