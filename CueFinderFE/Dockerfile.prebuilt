# Lightweight production image — expects files to already be built on the host.
# The deploy script runs pnpm build BEFORE docker compose, so this stage
# just copies the static output into nginx. No Node.js or pnpm needed here,
# which avoids runc/OOM issues on memory-constrained servers.

FROM nginx:alpine

# curl is required for the Docker health check defined in docker-compose.prod.yml
RUN apk add --no-cache curl

# Copy the React build output (built by pnpm on the host before this step)
COPY packages/app/build /usr/share/nginx/html

# Copy nginx config
COPY packages/app/nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
