# Production Environment Variables for CueFinder
# Copy this file to .env on your production server and update the values

# Database Configuration
DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# JWT Secret Key (must be at least 32 characters)
JWT_SECRET=REPLACE_WITH_SECURE_JWT_SECRET_MIN_32_CHARS

# Frontend URL and CORS Configuration
FRONTEND_API_URL=https://billiardscuefinder.com/api
CORS_FRONTEND_ORIGIN=https://billiardscuefinder.com

# Optional: Backend URL (if different from frontend)
BACKEND_URL=https://billiardscuefinder.com
