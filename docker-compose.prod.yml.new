# Production Docker Compose with Blue-Green Deployment Support
# Use: docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# Use: docker-compose -f docker-compose.yml -f docker-compose.prod.yml --profile staging up -d

services:
  postgres:
    container_name: cuefinder-postgres-prod
    restart: always
    image: postgres:15
    ports: []  # Override base compose to remove external port exposure
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./backups:/backups
    environment:
      POSTGRES_DB: cuefinder
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${DB_PASSWORD}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d cuefinder"]
      interval: 10s
      timeout: 5s
      retries: 5
    deploy:
      resources:
        limits:
          memory: 1G
        reservations:
          memory: 512M
    networks:
      - cuefinder-network

  # Ensure PgAdmin from the base compose is not exposed publicly in production
  pgadmin:
    ports: []

  opennsfw:
    container_name: cuefinder-opennsfw-prod
    restart: always
    build:
      context: ./deployment
      dockerfile: Dockerfile.nudenet
    ports: []
    volumes:
      - opennsfw_cache:/app/.opennsfw2
      - ./uploads/moderation:/tmp/moderation
    networks:
      - cuefinder-network
    environment:
      - PYTHONUNBUFFERED=1
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    deploy:
      resources:
        limits:
          memory: 2G
        reservations:
          memory: 1G
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # Blue slot backend service
  backend-blue:
    container_name: cuefinder-backend-blue
    restart: always
    build:
      context: .
      dockerfile: ./CueFinderBE/Dockerfile
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - ASPNETCORE_URLS=http://+:5000
      - ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=cuefinder;Username=postgres;Password=${DB_PASSWORD};SslMode=Disable;
      - JwtSettings__SecretKey=${JWT_SECRET}
      - JwtSettings__Issuer=cuefinder.com
      - JwtSettings__Audience=cuefinder.com
      - JwtSettings__ExpirationMinutes=1440
      - CorsOrigins__Frontend=${CORS_FRONTEND_ORIGIN}
      - BASE_URL=https://billiardscuefinder.com
      - FRONTEND_URL=${CORS_FRONTEND_ORIGIN}
      - ImageStorageSettings__StoragePath=/app/uploads/cues
      - ImageStorageSettings__ImageUrlBase=/uploads/cues
      - ImageStorageSettings__MaxFileSizeBytes=10485760
      - ImageStorageSettings__AllowedExtensions=.jpg,.jpeg,.png,.gif,.webp
      - ImageStorageSettings__AllowedMimeTypes=image/jpeg,image/png,image/gif,image/webp
      - Moderation__NudeNetUrl=http://cuefinder-opennsfw-prod:8000
    ports:
      - "5001:5000"
    depends_on:
      postgres:
        condition: service_healthy
      opennsfw:
        condition: service_healthy
    volumes:
      - ./uploads:/app/uploads
    healthcheck:
      test:
        - CMD-SHELL
        - "curl -f http://localhost:5000/health || exit 1"
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
    labels:
      - "app=backend"
      - "slot=blue"
      - "version=production"
    networks:
      - cuefinder-network
    deploy:
      resources:
        limits:
          memory: 1.5G
        reservations:
          memory: 1G
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "3"

  # Green slot backend service (staging by default, activated on deployment)
  backend-green:
    container_name: cuefinder-backend-green
    restart: always
    build:
      context: .
      dockerfile: ./CueFinderBE/Dockerfile
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - ASPNETCORE_URLS=http://+:5000
      - ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=cuefinder;Username=postgres;Password=${DB_PASSWORD};SslMode=Disable;
      - JwtSettings__SecretKey=${JWT_SECRET}
      - JwtSettings__Issuer=cuefinder.com
      - JwtSettings__Audience=cuefinder.com
      - JwtSettings__ExpirationMinutes=1440
      - CorsOrigins__Frontend=${CORS_FRONTEND_ORIGIN}
      - BASE_URL=https://billiardscuefinder.com
      - FRONTEND_URL=${CORS_FRONTEND_ORIGIN}
      - ImageStorageSettings__StoragePath=/app/uploads/cues
      - ImageStorageSettings__ImageUrlBase=/uploads/cues
      - ImageStorageSettings__MaxFileSizeBytes=10485760
      - ImageStorageSettings__AllowedExtensions=.jpg,.jpeg,.png,.gif,.webp
      - ImageStorageSettings__AllowedMimeTypes=image/jpeg,image/png,image/gif,image/webp
      - Moderation__NudeNetUrl=http://cuefinder-opennsfw-prod:8000
    ports:
      - "5002:5000"
    depends_on:
      postgres:
        condition: service_healthy
      opennsfw:
        condition: service_healthy
    volumes:
      - ./uploads:/app/uploads
    healthcheck:
      test:
        - CMD-SHELL
        - "curl -f http://localhost:5000/health || exit 1"
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
    labels:
      - "app=backend"
      - "slot=green"
      - "version=production"
    networks:
      - cuefinder-network
    deploy:
      resources:
        limits:
          memory: 1.5G
        reservations:
          memory: 1G
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "3"
    profiles:
      - staging  # Only starts when explicitly requested or during deployment

  moderator:
    container_name: cuefinder-moderator-prod
    restart: always
    build:
      context: .
      dockerfile: ./CueFinderModerator/Dockerfile
    ports: []  # Not exposed externally in production
    depends_on:
      postgres:
        condition: service_healthy
    volumes:
      - ./uploads:/app/uploads
    networks:
      - cuefinder-network
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=cuefinder;Username=postgres;Password=${DB_PASSWORD};SslMode=Disable;
      - JwtSettings__SecretKey=${JWT_SECRET}
      - JwtSettings__Issuer=cuefinder.com
      - JwtSettings__Audience=cuefinder.com
      - JwtSettings__ExpirationMinutes=1440
      - Moderation__NudeNetUrl=http://cuefinder-opennsfw-prod:8000
    healthcheck:
      test:
        - CMD-SHELL
        - "curl -f http://localhost:5000/health || exit 1"
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: 1G
        reservations:
          memory: 512M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  postgres_data:
    driver: local
  opennsfw_cache:
    driver: local
  pgadmin_data:
    driver: local

networks:
  cuefinder-network:
    driver: bridge
