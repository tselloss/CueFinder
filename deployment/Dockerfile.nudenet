FROM python:3.11-slim

WORKDIR /app

ENV KERAS_BACKEND=tensorflow \
    OPENNSFW2_HOME=/app/.opennsfw2

# Install system dependencies for onnxruntime and image decoding
RUN apt-get update && apt-get install -y \
    gcc \
    python3-dev \
    libxcb1 \
    libxkbcommon0 \
    libglib2.0-0 \
    libgl1 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (OpenNSFW2 + FastAPI stack)
RUN pip install --no-cache-dir \
    fastapi \
    "uvicorn[standard]" \
    pillow \
    tensorflow-cpu \
    python-multipart \
    opennsfw2 \
    onnxruntime \
    requests

# Pre-fetch model weights so runtime is deterministic
RUN python - <<'PY'
import opennsfw2 as n2
n2.make_open_nsfw_model()
PY

# Copy service code
COPY nudenet_service.py .

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health')"

# Run service
CMD ["python", "nudenet_service.py"]
