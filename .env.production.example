# CueFinder Production Environment Variables
# Copy this file to .env.production and fill in your actual values
# NEVER commit .env.production to git!

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Generate strong password: openssl rand -base64 32
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_32_CHARS_MIN

# ==========================================
# JWT AUTHENTICATION
# ==========================================
# Generate JWT secret: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_JWT_SECRET_MINIMUM_64_CHARS_LONG_RANDOM_STRING

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
# Replace with your actual domain
FRONTEND_API_URL=https://billiardscuefinder.com/api
CORS_FRONTEND_ORIGIN=https://billiardscuefinder.com

# ==========================================
# BACKEND API CONFIGURATION
# ==========================================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

# ==========================================
# SMS VERIFICATION (Optional - Twilio)
# ==========================================
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid_here

# ==========================================
# EMAIL CONFIGURATION (Optional - SMTP)
# ==========================================
# For Gmail: Enable 2FA and create App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=CueFinder

# ==========================================
# IMAGE UPLOAD SETTINGS
# ==========================================
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp
UPLOAD_PATH=/app/wwwroot/uploads

# ==========================================
# CORS SETTINGS
# ==========================================
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==========================================
# LOGGING & MONITORING
# ==========================================
LOG_LEVEL=Information
ENABLE_DETAILED_ERRORS=false

# ==========================================
# DOMAIN & SSL
# ==========================================
DOMAIN_NAME=yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# ==========================================
# BACKUP SETTINGS
# ==========================================
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# ==========================================
# RATE LIMITING (Optional)
# ==========================================
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# ==========================================
# EXTERNAL SERVICES (Optional)
# ==========================================
# Google OAuth (if implementing social login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple OAuth (if implementing social login)
APPLE_CLIENT_ID=your_apple_client_id
APPLE_CLIENT_SECRET=your_apple_client_secret

# ==========================================
# NOTES
# ==========================================
# 1. Generate strong passwords using: openssl rand -base64 32
# 2. Keep this file secure and never commit to version control
# 3. Add .env.production to .gitignore
# 4. Restart containers after changing values: docker-compose restart
# 5. Check logs: docker-compose logs -f
