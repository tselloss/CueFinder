{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=cuefinder;Username=postgres;Password=CHANGE_ME_IN_PRODUCTION;SslMode=Disable;"
  },
  "JwtSettings": {
    "SecretKey": "CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS",
    "Issuer": "CueFinder",
    "Audience": "CueFinderUsers",
    "ExpirationMinutes": 60
  },
  "Sms": {
    "Provider": "Mock",
    "ApiUrl": "",
    "ApiKey": "",
    "SenderId": "CueFinder"
  },
  "CorsOrigins": {
    "Frontend": "http://localhost:3000"
  },
  "Caching": {
    "DefaultAbsoluteExpirationMinutes": 60,
    "DefaultSlidingExpirationMinutes": 20,
    "MaxCacheSize": 1000,
    "EnableCaching": true,
    "CompressionThreshold": 1024,
    "EnableStatistics": true
  },
  "ImageStorage": {
    "StoragePath": "uploads/cues",
    "ImageUrlBase": "/uploads/cues",
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": ".jpg,.jpeg,.png,.gif,.webp",
    "AllowedMimeTypes": "image/jpeg,image/jpg,image/png,image/gif,image/webp"
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "FromEmail": "your-email@gmail.com",
    "FromName": "CueFinder Admin",
    "SmtpPassword": "CHANGE_ME_IN_PRODUCTION",
    "EnableSsl": true
  },
  "ModerationServiceUrl": "http://localhost:5001"
}
