{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CorsOrigins": {
    "Frontend": "https://billiardscuefinder.com"
  },
  "ImageStorage": {
    "StoragePath": "/app/uploads/cues",
    "ImageUrlBase": "/uploads/cues",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": ".jpg,.jpeg,.png,.gif,.webp",
    "AllowedMimeTypes": "image/jpeg,image/png,image/gif,image/webp"
  },
  "EmailSettings": {
    "SmtpServer": "CHANGE_ME_IN_PRODUCTION",
    "SmtpPort": 587,
    "FromEmail": "CHANGE_ME_IN_PRODUCTION",
    "FromName": "CueFinder Admin",
    "SmtpPassword": "CHANGE_ME_IN_PRODUCTION",
    "EnableSsl": true
  },
  "ModerationServiceUrl": "http://cuefinder-moderator-prod:5001"
}
