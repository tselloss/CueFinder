{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "CorsOrigins": {
    "Frontend": "https://billiardscuefinder.com"
  },
  "AppUrl": "https://billiardscuefinder.com",
  "ImageStorage": {
    "StoragePath": "uploads/cues",
    "ImageUrlBase": "/uploads/cues",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": ".jpg,.jpeg,.png,.gif,.webp",
    "AllowedMimeTypes": "image/jpeg,image/png,image/gif,image/webp"
  },
  "EmailSettings": {
    "SmtpServer": "${SMTP_SERVER:smtp.gmail.com}",
    "SmtpPort": 587,
    "FromEmail": "${EMAIL_FROM:cuefinderinfo@gmail.com}",
    "FromName": "${EMAIL_FROM_NAME:CueFinder Support}",
    "SmtpPassword": "${SMTP_PASSWORD}",
    "EnableSsl": true
  },
  "GmailApi": {
    "Enabled": true,
    "ClientId": "${GMAIL_CLIENT_ID}",
    "ClientSecret": "${GMAIL_CLIENT_SECRET}",
    "ProjectId": "${GMAIL_PROJECT_ID}",
    "FromEmail": "${EMAIL_FROM:cuefinderinfo@gmail.com}",
    "FromName": "${EMAIL_FROM_NAME:CueFinder Support}",
    "TokenPath": "/var/lib/cuefinder/gmail_token.json"
  },
  "ModerationServiceUrl": "http://cuefinder-moderator-prod:5001",
  "JWT": {
    "Secret": "${JWT_SECRET}",
    "ExpirationMinutes": 1440
  }
}
